# ─────────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────────
# Leave DATABASE_URL empty to use the embedded PGlite database
# (persisted to .data/pglite locally; in-memory on Vercel).
#
# Local Postgres (docker compose up -d db):
#   DATABASE_URL=postgres://postgres:postgres@localhost:5432/korea_saas
# Neon / Vercel Postgres: use the *pooled* connection string.
DATABASE_URL=

# Optional: where PGlite stores data when DATABASE_URL is empty.
# Use "memory://" for a throwaway database.
PGLITE_DATA_DIR=

# Max connections per server instance (postgres driver only).
DB_POOL_MAX=5

# ─────────────────────────────────────────────────────────────
# AI (optional). Without a key, every AI feature falls back to
# deterministic Korean templates, so the app works fully offline.
# ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Claude calls allowed per workspace per day.
AI_DAILY_LIMIT=30

# ─────────────────────────────────────────────────────────────
# Operations
# ─────────────────────────────────────────────────────────────
# Protects /api/cron/* (Vercel Cron sends "Authorization: Bearer <CRON_SECRET>").
CRON_SECRET=
# Days of inactivity before an anonymous demo workspace is purged.
WORKSPACE_TTL_DAYS=30
# Public origin, used for metadata/sitemap. Vercel sets VERCEL_PROJECT_PRODUCTION_URL automatically.
NEXT_PUBLIC_SITE_URL=
