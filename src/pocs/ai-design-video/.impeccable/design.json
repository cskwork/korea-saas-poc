  "narrative": {
    "northStar": "The 콘티 Sheet",
    "overview": "The studio is run from a storyboard (콘티) sheet: cool copier paper on a pale gray desk, printed with ink-black ruled tables and header blocks of labelled form cells. Every order is a cut on that sheet, drawn as a frame at the deliverable's true aspect ratio, with the format's non-photo-blue safe-area guides inside. Stage is the drawing medium: dashed blue sketch, graphite pencil line, red correction pencil, black ink with a circled OK; the frame redraws itself when the stage changes.",
    "keyCharacteristics": [
      "One sheet per page: a title block with printed header cells, then ruled content; no floating cards.",
      "Frames at true aspect ratio carry the product's state; text beside them always names the stage too.",
      "Ink for structure and primary action, blue pencil for sketch/in-progress and focus, red pencil only for 수정, overdue and destructive.",
      "Condensed printed-form numerals for cut numbers, counts, D-days, timecodes and prices in header cells.",
      "Motion only as state: 460ms stroke draw with exponential ease-out; nothing animates on first load."
    ],
    "rules": [
      {
        "name": "The Pencil Means Something Rule",
        "body": "Blue is sketch, progress and focus; red is correction, lateness and deletion. A new use of either color must mean one of those, or it is ink or graphite.",
        "section": "colors"
      },
      {
        "name": "The Paper Rule",
        "body": "The ground is cool copier paper on a cool gray desk. Never warm it toward cream or ivory.",
        "section": "colors"
      },
      {
        "name": "The Rough Stays Inside Rule",
        "body": "Black Han Sans renders only inside a frame as a piece's own copy; below ~9px it is dropped and the frame shows plain copy bars instead.",
        "section": "typography"
      },
      {
        "name": "The Printed Numeral Rule",
        "body": "Counts, codes, durations and aspect labels use the condensed numeral face with tabular figures; running prose never does.",
        "section": "typography"
      },
      {
        "name": "The Paper On Desk Rule",
        "body": "Only whole sheets and pinned pieces cast shadows; a box inside the sheet that needs separation gets a rule.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do show every order as its frame at the true aspect ratio, and name its stage in text beside it.",
      "Do keep pages as one sheet: title block with printed header cells, then ruled rows.",
      "Do use blue pencil for focus, selection highlights and sketch/in-progress, and red pencil only for 수정, overdue and destructive actions.",
