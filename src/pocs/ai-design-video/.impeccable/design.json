  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Ink rectangle for the one main action of a sheet (주문 접수하기, 납품 완료).",
      "html": "<button class=\"ds-btn\">주문 접수하기</button>",
      "css": ":host{--paper:#fbfdfe;--ink:#191d24;--ink-hover:#31363d;--graphite:#53595f;--pencil:#888d92;--wash:#eef3f7;--wash-strong:#e0e7ec;--rule:#d1d5d8;--blue-line:#3e9dca;--blue-ink:#0068a7;--red:#ca322e;--red-wash:#ffefec;font-family:'Pretendard Variable',Pretendard,system-ui,sans-serif;color:var(--ink)}.ds-btn{display:inline-flex;align-items:center;gap:8px;min-height:40px;padding:0 16px;border:1.5px solid var(--ink);border-radius:2px;background:var(--ink);color:var(--paper);font-size:15px;font-weight:600;cursor:pointer;transition:background-color 160ms cubic-bezier(0.16,1,0.3,1)}.ds-btn:hover{background:var(--ink-hover);border-color:var(--ink-hover)}.ds-btn:focus-visible{outline:2px solid var(--blue-ink);outline-offset:2px}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Paper button with an ink border for alternate moves (수정 요청 기록, 주문 수정).",
      "html": "<button class=\"ds-btn-2\">수정 요청 기록</button>",
      "css": ":host{--paper:#fbfdfe;--ink:#191d24;--ink-hover:#31363d;--graphite:#53595f;--pencil:#888d92;--wash:#eef3f7;--wash-strong:#e0e7ec;--rule:#d1d5d8;--blue-line:#3e9dca;--blue-ink:#0068a7;--red:#ca322e;--red-wash:#ffefec;font-family:'Pretendard Variable',Pretendard,system-ui,sans-serif;color:var(--ink)}.ds-btn-2{min-height:40px;padding:0 16px;border:1.5px solid var(--ink);border-radius:2px;background:var(--paper);color:var(--ink);font-size:15px;font-weight:600;cursor:pointer}.ds-btn-2:hover{background:var(--wash)}.ds-btn-2:focus-visible{outline:2px solid var(--blue-ink);outline-offset:2px}"
    },
