      "css": ":host{--paper:#fbfdfe;--ink:#191d24;--ink-hover:#31363d;--graphite:#53595f;--pencil:#888d92;--wash:#eef3f7;--wash-strong:#e0e7ec;--rule:#d1d5d8;--blue-line:#3e9dca;--blue-ink:#0068a7;--red:#ca322e;--red-wash:#ffefec;font-family:'Pretendard Variable',Pretendard,system-ui,sans-serif;color:var(--ink)}.ds-btn-d{min-height:34px;padding:0 12px;border:1.5px solid var(--red);border-radius:2px;background:var(--paper);color:var(--red);font-size:14px;font-weight:600;cursor:pointer}.ds-btn-d:hover{background:var(--red-wash)}.ds-btn-d:focus-visible{outline:2px solid var(--blue-ink);outline-offset:2px}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Paper field with a pencil border; label above, hint/error below.",
      "html": "<label class=\"ds-field\"><span>작업명</span><input class=\"ds-input\" placeholder=\"예: 가을 신메뉴 릴스 3편\"></label>",
      "css": ":host{--paper:#fbfdfe;--ink:#191d24;--ink-hover:#31363d;--graphite:#53595f;--pencil:#888d92;--wash:#eef3f7;--wash-strong:#e0e7ec;--rule:#d1d5d8;--blue-line:#3e9dca;--blue-ink:#0068a7;--red:#ca322e;--red-wash:#ffefec;font-family:'Pretendard Variable',Pretendard,system-ui,sans-serif;color:var(--ink)}.ds-field{display:grid;gap:6px;font-size:14px;font-weight:600}.ds-input{min-height:42px;padding:9px 12px;border:1px solid var(--pencil);border-radius:2px;background:var(--paper);font:inherit;font-weight:400;font-size:15px}.ds-input:hover{border-color:var(--graphite)}.ds-input:focus-visible{border-color:var(--blue-ink);outline:2px solid rgba(0,104,167,.35);outline-offset:0}"
    },
    {
      "name": "Nav Cells",
      "kind": "nav",
      "refersTo": "nav-cell",
      "description": "The printed top bar: ruled cells, current one washed with a 4px ink underline.",
      "html": "<nav class=\"ds-nav\"><a class=\"ds-cell\" aria-current=\"page\">오늘</a><a class=\"ds-cell\">주문</a><a class=\"ds-cell\">포트폴리오</a></nav>",
      "css": ":host{--paper:#fbfdfe;--ink:#191d24;--ink-hover:#31363d;--graphite:#53595f;--pencil:#888d92;--wash:#eef3f7;--wash-strong:#e0e7ec;--rule:#d1d5d8;--blue-line:#3e9dca;--blue-ink:#0068a7;--red:#ca322e;--red-wash:#ffefec;font-family:'Pretendard Variable',Pretendard,system-ui,sans-serif;color:var(--ink)}.ds-nav{display:flex;border-bottom:2px solid var(--ink);background:var(--paper)}.ds-cell{position:relative;display:flex;align-items:center;height:56px;padding:0 16px;border-right:1px solid var(--rule);color:var(--graphite);font-size:15px;text-decoration:none;cursor:pointer}.ds-cell:hover{background:var(--wash);color:var(--ink)}.ds-cell[aria-current]{background:var(--wash);color:var(--ink);font-weight:700}.ds-cell[aria-current]::after{content:'';position:absolute;left:0;right:0;bottom:-2px;height:4px;background:var(--ink)}"
    },
    {
      "name": "Header Cell",
      "kind": "custom",
      "refersTo": "header-cell",
      "description": "A labelled form cell of the sheet's title block; linked cells filter the sheet.",
      "html": "<dl class=\"ds-cells\"><div class=\"ds-hc\"><dt>S#2 시안작업</dt><dd>8컷</dd></div><div class=\"ds-hc ds-alert\"><dt>S#3 수정요청</dt><dd>2컷</dd></div></dl>",
      "css": ":host{--paper:#fbfdfe;--ink:#191d24;--ink-hover:#31363d;--graphite:#53595f;--pencil:#888d92;--wash:#eef3f7;--wash-strong:#e0e7ec;--rule:#d1d5d8;--blue-line:#3e9dca;--blue-ink:#0068a7;--red:#ca322e;--red-wash:#ffefec;font-family:'Pretendard Variable',Pretendard,system-ui,sans-serif;color:var(--ink)}.ds-cells{display:grid;grid-template-columns:repeat(2,140px);margin:0;border-left:1px solid var(--rule)}.ds-hc{padding:14px 16px 16px;border-right:1px solid var(--rule);border-bottom:1px solid var(--rule)}.ds-hc dt{font-size:13px;color:var(--graphite)}.ds-hc dd{margin:0;font-family:'Barlow Condensed',sans-serif;font-size:24px;font-weight:600}.ds-alert dt,.ds-alert dd{color:var(--red)}.ds-hc:hover{background:var(--wash)}"
    },
    {
      "name": "Stage Frame",
      "kind": "custom",
      "refersTo": "frame",
      "description": "An order drawn at its deliverable's ratio; the outline medium is the stage (here: 수정요청 red pencil).",
      "html": "<div class=\"ds-frame\"><svg viewBox=\"0 0 160 90\"><rect x=\"8\" y=\"4.5\" width=\"144\" height=\"81\" fill=\"none\" stroke=\"#70bdde\" stroke-dasharray=\"3 3\"/><rect x=\"86\" y=\"9\" width=\"64\" height=\"72\" fill=\"rgba(136,141,146,.08)\" stroke=\"#888d92\"/><path d=\"M86 9L150 81M150 9L86 81\" stroke=\"#888d92\" stroke-width=\".9\"/><rect x=\"11\" y=\"27\" width=\"64\" height=\"12\" fill=\"rgba(136,141,146,.6)\"/><rect x=\"1\" y=\"1\" width=\"158\" height=\"88\" fill=\"none\" stroke=\"#ca322e\" stroke-width=\"2\"/></svg><span class=\"ds-cap\">16:9</span></div>",
      "css": ":host{--paper:#fbfdfe;--ink:#191d24;--ink-hover:#31363d;--graphite:#53595f;--pencil:#888d92;--wash:#eef3f7;--wash-strong:#e0e7ec;--rule:#d1d5d8;--blue-line:#3e9dca;--blue-ink:#0068a7;--red:#ca322e;--red-wash:#ffefec;font-family:'Pretendard Variable',Pretendard,system-ui,sans-serif;color:var(--ink)}.ds-frame{display:inline-grid;gap:6px}.ds-frame svg{width:160px;height:90px;background:var(--paper)}.ds-cap{font-family:'Barlow Condensed',sans-serif;font-size:13px;color:var(--blue-ink)}"
    }
